   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="206"></NameColumnWidth>
      <ValueColumnWidth column_width="188"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="4" />
   <wvobject fp_name="group19" type="group">
      <obj_property name="label">Counters</obj_property>
