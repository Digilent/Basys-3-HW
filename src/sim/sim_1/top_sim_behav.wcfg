<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="top_sim_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="top_sim_tb" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
